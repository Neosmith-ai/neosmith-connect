{
  "router": {
    "baseUrl": "https://router.neosmith.ai",
    "openaiBaseUrl": "https://router.neosmith.ai/v1"
  },
  "models": {
    "pro": "neosmith.intelligent-pro",
    "basic": "neosmith.intelligent-basic",
    "lite": "neosmith.intelligent-lite",
    "maestro": "neosmith.intelligent-maestro"
  },
  "claudeTierMap": {
    "opus":   { "slot": "OPUS",   "model": "neosmith.intelligent-pro",     "name": "NeoSmith Pro",     "description": "Cost-optimised with Opus escalation" },
    "sonnet": { "slot": "SONNET", "model": "neosmith.intelligent-basic",   "name": "NeoSmith Basic",   "description": "Cost-optimised with Sonnet ceiling" },
    "haiku":  { "slot": "HAIKU",  "model": "neosmith.neolite",             "name": "NeoSmith NeoLite", "description": "Sealed budget tier · 512K · cheapest" },
    "fable":  { "slot": "FABLE",  "model": "neosmith.intelligent-maestro", "name": "NeoSmith Maestro", "description": "Highest-accuracy agentic coding" }
  },
  "releaseChannel": "stable",
  "harnesses": [
    {
      "id": "claude",
      "name": "Claude Code",
      "module": "./lib/harnesses/claude.js",
      "writable": true,
      "configFile": "~/.claude/settings.json",
      "wire": "anthropic-messages",
      "defaultModel": "pro",
      "keyMode": "literal-anthropic-token",
      "idempotency": "warn-noop",
      "registryOrder": 1,
      "addedIn": "0.2.0",
      "docPage": "agents/claude-code.md",
      "shortLabel": "Claude Code"
    },
    {
      "id": "codex",
      "name": "Codex",
      "module": "./lib/harnesses/codex.js",
      "writable": true,
      "configFile": "~/.codex/config.toml",
      "wire": "openai-responses",
      "defaultModel": "pro",
      "keyMode": "env-key-ref",
      "idempotency": "snapshot-always",
      "registryOrder": 2,
      "addedIn": "0.2.0",
      "docPage": "agents/codex.md",
      "shortLabel": "Codex"
    },
    {
      "id": "continue",
      "name": "Continue",
      "module": "./lib/harnesses/continue.js",
      "writable": true,
      "configFile": "~/.continue/config.yaml",
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "literal-openai-key",
      "idempotency": "snapshot-always",
      "registryOrder": 3,
      "addedIn": "0.2.0",
      "extras": { "autocomplete": true },
      "docPage": "agents/continue.md",
      "shortLabel": "Continue"
    },
    {
      "id": "cline",
      "name": "Cline",
      "module": "./lib/harnesses/cline.js",
      "writable": false,
      "configFile": null,
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "ui-driven",
      "registryOrder": 4,
      "addedIn": "0.2.0",
      "docPage": "agents/cline.md",
      "shortLabel": "Cline"
    },
    {
      "id": "jetbrains",
      "name": "JetBrains AI",
      "module": "./lib/harnesses/jetbrains.js",
      "writable": false,
      "configFile": null,
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "ui-driven",
      "registryOrder": 5,
      "addedIn": "0.2.0",
      "perFeatureModels": {
        "chat": "pro",
        "inline": "lite",
        "commit": "lite",
        "test": "basic"
      },
      "docPage": "agents/jetbrains-ai.md",
      "shortLabel": "JetBrains AI"
    },
    {
      "id": "copilot",
      "name": "Copilot Chat",
      "module": "./lib/harnesses/copilot.js",
      "writable": true,
      "configFile": "vscode://globalStorage/github.copilot-chat/chatLanguageModels.json",
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "ui-keychain",
      "idempotency": "warn-noop",
      "registryOrder": 6,
      "addedIn": "0.3.0",
      "docPage": "agents/copilot.md",
      "shortLabel": "Copilot Chat",
      "notes": "API key stored in VS Code OS-keychain SecretStorage; CLI registers model entries only."
    },
    {
      "id": "zed",
      "name": "Zed",
      "module": "./lib/harnesses/zed.js",
      "writable": true,
      "configFile": "~/.config/zed/settings.json",
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "literal-openai-key",
      "idempotency": "warn-noop",
      "registryOrder": 7,
      "addedIn": "0.3.0",
      "docPage": "agents/zed.md",
      "shortLabel": "Zed"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "module": "./lib/harnesses/cursor.js",
      "writable": false,
      "configFile": null,
      "wire": "openai-completions",
      "defaultModel": "pro",
      "keyMode": "ui-driven",
      "registryOrder": 8,
      "addedIn": "0.3.0",
      "docPage": "ides/cursor.md",
      "shortLabel": "Cursor",
      "notes": "Re-verified 2026-08-07 against the installed Cursor build: native BYOK is stored in an encrypted, server-synced store (aiserver.v1 byok/apiKeyCandidates/baseUrlCandidates), NOT settings.json — the string 'cursor.models.' never appears in Cursor's workbench bundle. Configured via Settings → Models UI and requires Cursor Pro/Ultra. CLI prints paste-in values. Scriptable alternative: Claude Code extension (`neosmith claude on`)."
    }
  ]
}
