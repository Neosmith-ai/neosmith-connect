{
  "name": "@neosmithai/cli",
  "version": "0.8.0",
  "description": "Route AI coding agents (Claude Code, Codex, Continue, Cline, JetBrains AI) through the NeoSmith router \u2014 same experience, ~60% lower inference cost.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "continue",
    "cline",
    "jetbrains",
    "anthropic",
    "openai",
    "router",
    "llm",
    "neosmith"
  ],
  "homepage": "https://neosmith-ai.github.io/neosmith-connect/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neosmith-ai/neosmith-connect.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Neosmith-ai/neosmith-connect/issues",
  "license": "MIT",
  "author": "NeoSmith AI <contact-us@neosmith.ai>",
  "bin": {
    "neosmith": "bin/neosmith.js"
  },
  "main": "bin/neosmith.js",
  "files": [
    "bin/",
    "lib/",
    "contract/",
    "harnesses.json",
    "install.sh",
    "install.ps1",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/run-contract.js",
    "test:all": "node scripts/run-contract.js",
    "smoke": "node scripts/smoke.js",
    "smoke:ci": "node scripts/smoke.js --quiet",
    "install-hook": "node scripts/install-hook.js",
    "test:router-facing": "node scripts/run-contract.js --only router-contract,models,env",
    "e2e:offline": "node scripts/e2e/offline.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  }
